AWS_REGION=ca-central-1
USER_TIMEZONE=America/Vancouver
BEDROCK_MODEL_ID=ca.amazon.nova-lite-v1:0

# Local AWS credentials. Prefer AWS profiles or your shell credential chain
# for local development; never commit real values to this file.
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-optional-session-token

# Used by `npm run claude`; override with a regional Claude model if needed.
CLAUDE_MODEL_ID=ca.amazon.nova-lite-v1:0
# CLAUDE_MAX_TOKENS=3000

# Optional AgentCore routing (normally configured as Worker secrets).
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:region:account:runtime/runtime-id
# AGENTCORE_RUNTIME_HOST=bedrock-agentcore.ca-central-1.amazonaws.com

# Optional live-search model overrides.
OPENAI_SEARCH_MODEL=gpt-4.1-mini
GEMINI_SEARCH_MODEL=gemini-3.6-flash
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Recommended: route all local Python agents through the Worker.
# FORGE_WORKER_URL=https://larboard.ca
# FORGE_WORKER_TOKEN=your-worker-token
# FORGE_AGENT_ID=forge

# Optional local Python runtime/storage settings.
# FORGE_PALETTE_BUCKET=your-r2-bucket-name
# FORGE_PALETTE_KEY_PREFIX=palettes/
# FORGE_SESSION_TABLE=your-dynamodb-table-name
# FORGE_SESSION_BUCKET=your-s3-bucket-name
# FORGE_SESSION_PREFIX=forge-sessions/
# FORGE_DEFAULT_PROFILE=forge
# FORGE_MAX_TOOL_CALLS=3
# LIVE_SEARCH_TIMEOUT_SECONDS=30

# Worker-only secrets; set these with your deployment platform instead of
# exposing them to the browser.
# FEEDBACK_ADMIN_TOKEN=your-feedback-admin-token
# FORGE_WORKER_TOKEN=your-worker-token
# MODEL_REQUESTS_ENABLED=false

# Optional per-million-token prices for cost estimates when using a model not built into the terminal.
# BEDROCK_INPUT_PRICE_PER_MILLION=0.06
# BEDROCK_OUTPUT_PRICE_PER_MILLION=0.24
PORT=3000
