+[build-system]
+requires = ["hatchling>=1.27,<2"]
+build-backend = "hatchling.build"
+
+[project]
+name = "beeplex"
+version = "0.2.0"
+description = "Chat with your Bee memories through MCP."
+readme = "README.md"
+requires-python = ">=3.11"
+dependencies = ["mcp>=2,<3"]
+
+[project.optional-dependencies]
+reports = ["openpyxl>=3.1,<4", "python-docx>=1.1,<2", "python-pptx>=1,<2"]
+bedrock = ["boto3>=1.35,<2"]
+dev = ["pytest>=8,<10", "ruff>=0.12,<1"]
+
+[project.scripts]
+beeplex = "beeplex.__main__:main"
+
+[tool.hatch.build.targets.wheel]
+packages = ["beeplex"]
+
+[tool.hatch.build.targets.sdist]
+include = ["/beeplex", "/tests", "/simulator", "/README.md", "/pyproject.toml", "/uv.lock"]
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+
+[tool.ruff]
+target-version = "py311"
+
+[tool.ruff.lint]
+select = ["E9", "F63", "F7", "F82"]
