{
  "name": "forge-bedrock-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval:agents": "node scripts/evaluate-agents.js",
    "eval:simple": "node scripts/evaluate-simple.js",
    "eval:quality": "node scripts/evaluate-quality.js",
    "test:harness": "node --test tests/agent-harness.test.js",
    "start": "node server.mjs",
    "build": "npm --prefix site run build",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/worker.js && node --check server.mjs && node scripts/validate-skills.js && node scripts/validate-profiles.js",
    "validate-skills": "node scripts/validate-skills.js",
    "validate-profiles": "node scripts/validate-profiles.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:specialized": "node scripts/evaluate-specialized.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@strands-agents/sdk": "^1.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0"
  }
}
