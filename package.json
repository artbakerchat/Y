{
  "name": "bee-chat",
  "version": "1.0.0",
  "description": "Bee Chat - Mobile AI chat interface with Nova and music.py integration",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "npm --prefix site run build",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/worker.js && node --check server.mjs && node scripts/validate-skills.js && node scripts/validate-profiles.js && node scripts/validate-conversation-policy.js",
    "validate-skills": "node scripts/validate-skills.js",
    "validate-profiles": "node scripts/validate-profiles.js",
    "validate-conversation-policy": "node scripts/validate-conversation-policy.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0"
  }
}
